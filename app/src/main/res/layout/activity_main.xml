<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Fixed black top bar: buttons never move, preview never slides under them -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Switch camera"
            android:padding="12dp"
            android:src="@drawable/ic_camera_switch" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/toggleControlsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Open camera controls"
            android:padding="12dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Camera preview: full width, true preview aspect ratio; the ratio is set
         from the actual preview size once the camera opens. Remaining vertical
         space below stays black and holds the shutter button. -->
    <TextureView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <View
        android:id="@+id/flashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="72sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3"
        tools:visibility="visible" />

    <!-- Control panel: docked above the shutter button so the thumb does not have to
         reach the top of the screen. Scrollable because the manual controls are tall. -->
    <ScrollView
        android:id="@+id/controlsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_control_card"
        android:elevation="8dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/imageCaptureButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="400dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/rawModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="RAW"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginRight="50dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/manualModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Manual"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>

            <!-- Timer: 0-10 whole seconds, a stepper hits each value exactly. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timer: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/timerValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0s"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/timerDecreaseButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_stepper_button"
                    android:clickable="true"
                    android:contentDescription="Decrease timer"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/timerIncreaseButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stepper_button"
                    android:clickable="true"
                    android:contentDescription="Increase timer"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Burst count: 1-10 frames, also a stepper. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Burst Count: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/burstValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/burstDecreaseButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_stepper_button"
                    android:clickable="true"
                    android:contentDescription="Decrease burst count"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/burstIncreaseButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stepper_button"
                    android:clickable="true"
                    android:contentDescription="Increase burst count"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Wheels are the default. The legacy sliders stay reachable as an
                 accessibility escape hatch; both bind to the same controller, so
                 switching styles never loses the current selection. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual controls: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/classicSlidersSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Use classic sliders instead of wheels"
                    android:text="Classic sliders"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shutter Speed: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/shutterSpeedValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Shutter indexes the stop table, so each step is exactly one speed. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cusapps.astrocam.controls.DiscreteWheelView
                    android:id="@+id/shutterWheel"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/shutterSlider"
                    style="@style/Widget.AstroCam.Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISO: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/isoValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ISO indexes the one-third-stop table instead of every integer. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cusapps.astrocam.controls.DiscreteWheelView
                    android:id="@+id/isoWheel"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/isoSlider"
                    style="@style/Widget.AstroCam.Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Distance: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/focusDistanceValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Auto"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Coarse/fine gain is exposed explicitly. The wheel also drops to fine
                     gain automatically for short, deliberate drags. -->
                <TextView
                    android:id="@+id/focusFineModeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_stepper_button"
                    android:clickable="true"
                    android:contentDescription="Toggle fine focus adjustment"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Fine"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <!-- Infinity is a single tap rather than the last 1% of a track. -->
                <TextView
                    android:id="@+id/focusInfinityButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_stepper_button"
                    android:clickable="true"
                    android:contentDescription="Set focus to infinity"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="52dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="∞"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Focus uses a fine 0..1000 scale. The wheel decouples gain from that
                 density instead of squeezing every step onto one track, and its top
                 end is a hard infinity detent rather than the last 1% of a slider. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cusapps.astrocam.controls.FocusWheelView
                    android:id="@+id/focusWheel"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/focusSlider"
                    style="@style/Widget.AstroCam.Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    app:labelBehavior="floating"
                    app:tickVisible="false" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="White Balance: "
                    android:textColor="@color/control_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/whiteBalanceValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/whiteBalanceLockSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Lock white balance for consistent colour across a sequence"
                    android:text="Lock"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>

            <!-- White balance is already quantized to 81 x 100K steps. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.cusapps.astrocam.controls.DiscreteWheelView
                    android:id="@+id/whiteBalanceWheel"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="2dp"
                    android:enabled="false" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/whiteBalanceSlider"
                    style="@style/Widget.AstroCam.Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:enabled="false"
                    android:visibility="gone"
                    app:labelBehavior="floating"
                    app:tickVisible="true" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/imageCaptureButton"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/bg_capture_button"
        android:contentDescription="Take photo"
        android:elevation="6dp"
        android:padding="28dp"
        android:src="@drawable/ic_shutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
